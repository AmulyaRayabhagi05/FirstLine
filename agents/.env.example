# Copy to agents/.env and fill in. Never commit the real .env.
# Base URL of the OpenAI-compatible endpoint, ending in /v1
NEMOTRON_BASE_URL=
# API key the vLLM server was started with (--api-key)
NEMOTRON_API_KEY=
# Model name the server exposes, e.g. nvidia/NVIDIA-Nemotron-Nano-9B-v2
NEMOTRON_FAST_MODEL=
# Tiger Data (Timescale) connection string, e.g. postgres://user:pass@host:port/tsdb?sslmode=require
TIGER_DATABASE_URL=
# SpacetimeDB
SPACETIME_HOST=
SPACETIME_DB_NAME=
SPACETIME_TOKEN=
# Twilio (trial is fine)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public https URL Twilio reaches (e.g. ngrok); also the URL the webhook signature is checked against
PUBLIC_BASE_URL=
# Local dev only: 1 accepts unsigned webhooks when TWILIO_AUTH_TOKEN is empty. Never set in a deployment.
TWILIO_ALLOW_UNSIGNED=
# Census API key (free)
CENSUS_API_KEY=
# Meshtastic MQTT broker
MQTT_URL=
