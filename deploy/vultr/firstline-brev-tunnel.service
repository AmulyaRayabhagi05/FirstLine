# Keeps localhost:8000 on this server forwarded to vLLM (Nemotron) on the Brev GPU box.
# The Brev host and user live in /etc/firstline/brev.env (BREV_HOST, BREV_USER).
[Unit]
Description=FirstLine SSH tunnel to Nemotron on Brev
After=network-online.target
Wants=network-online.target

[Service]
User=firstline
EnvironmentFile=/etc/firstline/brev.env
ExecStart=/usr/bin/ssh -N -i /home/firstline/.ssh/brev_ed25519 \
  -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -L 127.0.0.1:8000:localhost:8000 ${BREV_USER}@${BREV_HOST}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
