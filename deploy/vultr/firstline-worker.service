# The Nemotron agent worker, against SpacetimeDB Maincloud. Config: /srv/firstline/repo/agents/.env
# (copied from the laptop, never committed). Demo-safe: SMS, mesh and outbound Twilio are off,
# because the seeded residents' phone numbers are fake. Remove those overrides only for real use.
[Unit]
Description=FirstLine Nemotron agent worker
After=network-online.target firstline-brev-tunnel.service
Wants=network-online.target firstline-brev-tunnel.service

[Service]
User=firstline
WorkingDirectory=/srv/firstline/repo/agents
Environment=NODE_ENV=production
Environment=NEMOTRON_BASE_URL=http://127.0.0.1:8000/v1
Environment=SPACETIME_HOST=https://maincloud.spacetimedb.com
Environment=SPACETIME_DB_NAME=firstline
Environment=CHANNEL_SMS=0 CHANNEL_MESH=0 FEEDS=1
Environment=TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_FROM_NUMBER=
ExecStart=/srv/firstline/repo/agents/node_modules/.bin/tsx src/index.ts
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
