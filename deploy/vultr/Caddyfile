207-148-5-196.sslip.io {
	encode gzip
	request_body {
		max_size 64KB
	}
	# Twilio SMS and voice webhooks -> the agent worker
	@twilio path /sms /sms/* /voice /voice/*
	handle @twilio {
		reverse_proxy 127.0.0.1:8787
	}
	# Resident app (PWA) at /app/: its own index.html, never the dashboard's
	redir /app /app/ 308
	handle /app/* {
		root * /srv/firstline/web
		try_files {path} /app/index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		@appassets path /app/assets/*
		header @appassets Cache-Control "public, max-age=31536000, immutable"
		@apppage not path /app/assets/*
		header @apppage Cache-Control "no-cache"
		@manifest path /app/manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
	}
	# FirstLine dashboard (static build; reads SpacetimeDB Maincloud as a read-only viewer)
	handle {
		root * /srv/firstline/web
		try_files {path} /index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# The page itself is always re-checked, so a deploy shows up on the next reload.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
	}
}
